# Whitelist-style ignore: exclude everything, then re-include only what the
# extension needs at runtime. New root files are excluded by default —
# published VSIXs <=2.3.1 leaked .env under the old blacklist approach.
**
.*
.*/**
**/.*

# Bundled extension + renderer output (top-level JS only; maps/subdirs stay out)
!dist/*.js

# Webview templates (free set; package-pro merges pro templates in temporarily)
!templates/**

# Icons, walkthrough media, marketplace metadata
!resources/**
!walkthroughs/**
!README.md
!CHANGELOG.md
!LICENSE
!package.json

# Vendored nexql-mcp platform binaries (pro MCP stdio spawn)
!bin/nexql-mcp/**

# Runtime dependencies kept external to the esbuild bundle
!node_modules/pg/**
!node_modules/pg-types/**
!node_modules/pg-protocol/**
!node_modules/pg-int8/**
!node_modules/pg-pool/**
!node_modules/pg-connection-string/**
!node_modules/pgpass/**
!node_modules/packet-reader/**
!node_modules/postgres-array/**
!node_modules/postgres-bytea/**
!node_modules/postgres-date/**
!node_modules/postgres-interval/**
!node_modules/postgres-range/**
!node_modules/split2/**
!node_modules/xtend/**
!node_modules/ssh2/**
!node_modules/asn1/**
!node_modules/bcrypt-pbkdf/**
!node_modules/cpu-features/**
!node_modules/nan/**
!node_modules/tweetnacl/**
!node_modules/safer-buffer/**
!node_modules/vscode-languageclient/**
!node_modules/vscode-languageserver/**

# Cursor provider (dynamic import in modelListing.ts / AiService.ts) — was
# missing entirely, causing "Cannot find package '@cursor/sdk'" at runtime.
# NOTE: @cursor/sdk depends on sqlite3 (native binding); no prebuilt .node
# binary is vendored here, so any code path that actually touches sqlite3
# will still fail per-platform until that's vendored like bin/nexql-mcp.
!node_modules/@cursor/**
!node_modules/@bufbuild/protobuf/**
!node_modules/@connectrpc/connect/**
!node_modules/@connectrpc/connect-node/**
!node_modules/@statsig/js-client/**
!node_modules/zod/**
!node_modules/sqlite3/**

# ERD DBML import (erdDbmlImport.ts) — same "external + never whitelisted" gap.
!node_modules/@dbml/core/**
!node_modules/@dbml/parse/**
!node_modules/antlr4/**
!node_modules/lodash/**
!node_modules/lodash-es/**
!node_modules/luxon/**
!node_modules/parsimmon/**
!node_modules/pluralize/**

# Local embedder (dbindex localEmbedder.ts) — same gap. onnxruntime-node,
# onnxruntime-web, and sharp are NOT whitelisted: they're native-binding deps
# of @huggingface/transformers that aren't declared in package.json here, so
# they're out of scope for this fix and need their own vendoring pass.
!node_modules/@huggingface/transformers/**
!node_modules/@huggingface/jinja/**
!node_modules/@huggingface/tokenizers/**
